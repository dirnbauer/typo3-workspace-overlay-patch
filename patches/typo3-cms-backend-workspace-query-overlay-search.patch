+    #[Test]
+    public function searchFindsWorkspaceVersionWhenSearchValueOnlyExistsInWorkspaceRow(): void
+    {
+        $connection = $this->get(ConnectionPool::class)->getConnectionForTable('tt_content');
+        $connection->insert('tt_content', [
+            'uid' => 9101,
+            'pid' => 1100,
+            'CType' => 'text',
+            'header' => 'Live workspace search source',
+            'bodytext' => '',
+            'sys_language_uid' => 0,
+            'l18n_parent' => 0,
+            'l10n_source' => 0,
+            'colPos' => 0,
+            'sorting' => 9101,
+            'hidden' => 0,
+            'deleted' => 0,
+            't3ver_oid' => 0,
+            't3ver_wsid' => 0,
+            't3ver_state' => 0,
+            't3ver_stage' => 0,
+        ]);
+        $connection->insert('tt_content', [
+            'uid' => 9102,
+            'pid' => 1100,
+            'CType' => 'text',
+            'header' => 'Draft-only workspace search needle',
+            'bodytext' => '',
+            'sys_language_uid' => 0,
+            'l18n_parent' => 0,
+            'l10n_source' => 0,
+            'colPos' => 0,
+            'sorting' => 9101,
+            'hidden' => 0,
+            'deleted' => 0,
+            't3ver_oid' => 9101,
+            't3ver_wsid' => 1,
+            't3ver_state' => 0,
+            't3ver_stage' => 0,
+        ]);
+        $this->backendUser->workspace = 1;
+        $GLOBALS['BE_USER'] = $this->backendUser;
+
+        $request = (new ServerRequest('http://localhost/'))
+            ->withAttribute('route', (new Route('/typo3/module/content/records', ['_identifier' => 'records'])))
+            ->withAttribute('site', $this->get(SiteFinder::class)->getSiteByIdentifier('test'));
+        $pageContext = $this->get(PageContextFactory::class)->createWithLanguages($request, 1100, [0], $this->backendUser);
+        $request = $request->withAttribute('pageContext', $pageContext);
+
+        $recordList = $this->get(DatabaseRecordList::class);
+        $recordList->setRequest($request);
+        $recordList->start(1100, 'tt_content', 0, 'Draft-only workspace search needle');
+
+        $listHtml = $recordList->generateList();
+
+        self::assertStringContainsString('Draft-only workspace search needle', $listHtml);
+        self::assertStringNotContainsString('Live workspace search source', $listHtml);
+    }
